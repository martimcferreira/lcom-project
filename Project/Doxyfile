PROJECT_NAME           = "Guitar Hero LCOM"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "LCOM 2026 Project - Guitar Hero Visual Application"

OUTPUT_DIRECTORY       = doxygen_docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Portuguese

# Optimization for C
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# Input source files
INPUT                  = . structures structures/drivers devices/video devices/uart structures/includes structures/includes/drivers structures/includes/game
FILE_PATTERNS          = *.c *.h
RECURSIVE              = YES

# Exclude assets from Doxygen
EXCLUDE_PATTERNS       = */assets/* */beatmaps/*

# Output formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

# Graphviz Settings for "20 valores" look
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = png
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_PATH               = 
DOT_TRANSPARENT        = YES
DOT_MULTI_TARGETS      = YES
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250
