-
-#define SCORE_BASE_POINTS 10
-#define SCORE_TIER_2_COMBO 4
-#define SCORE_TIER_3_COMBO 12
-#define SCORE_TIER_4_COMBO 24
-#define SCORE_TIER_5_COMBO 40
-
-#define A_MAKE_CODE 0x1E
-#define S_MAKE_CODE 0x1F
