-static void write_log(const char *format, ...) {
-  FILE *fp = fopen("/tmp/log.txt", "a");
-  if (fp != NULL) {
-    va_list args;
-    va_start(args, format);
-    vfprintf(fp, format, args);
-    va_end(args);
-    fclose(fp);
-  }
-}
