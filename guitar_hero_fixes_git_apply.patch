+static bool note_collides_with_hit_zone(const Note *note) {
+  int note_top = note->y;
+  int note_bottom = note->y + NOTE_HIT_HEIGHT;
+  return note_top <= HIT_ZONE_BOTTOM && note_bottom >= HIT_ZONE_TOP;
+}
