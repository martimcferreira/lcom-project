+static int lane_from_make_code(uint8_t make_code) {
+  switch (make_code) {
+    case A_MAKE_CODE: return 0;
+    case S_MAKE_CODE: return 1;
+    case D_MAKE_CODE: return 2;
+    case F_MAKE_CODE: return 3;
+    case G_MAKE_CODE: return 4;
+    default: return -1;
